# Copy to .env and replace both placeholders with independent random values.
API_NOTES_SECRET=replace-with-random-secret-at-least-32-characters
API_REPORTS_SECRET=replace-with-another-random-secret-at-least-32-characters
SEED_ALICE_PASSWORD=replace-with-a-local-synthetic-password
SEED_BOB_PASSWORD=replace-with-a-different-local-synthetic-password
SEED_ADMIN_PASSWORD=replace-with-a-third-local-synthetic-password
API_DB=api.sqlite3
NOTES_DB=notes.sqlite3
